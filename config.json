{
  "server": {
    "port": 3000,
    "host": "0.0.0.0"
  },
  "scraper": {
    "defaultConcurrency": 3,
    "maxConcurrency": 10,
    "defaultDelayMs": 350,
    "maxRetries": 3,
    "requestTimeoutMs": 12000,
    "userAgent": "UniversalBusinessScraper/2.0 (Public Research Directory Harvester)"
  },
  "providers": {
    "osmOverpass": {
      "enabled": true,
      "endpoints": [
        "https://overpass-api.de/api/interpreter",
        "https://overpass.kumi.systems/api/interpreter"
      ]
    },
    "socrataOpenData": {
      "enabled": true
    },
    "googlePlaces": {
      "enabled": false,
      "apiKey": ""
    },
    "yelpFusion": {
      "enabled": false,
      "apiKey": ""
    }
  },
  "database": {
    "path": "./data/scraper.db",
    "walMode": true
  }
}
