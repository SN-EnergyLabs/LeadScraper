# Universal Statewide Business Harvester & Dashboard Configuration

PORT=3000
NODE_ENV=development

# Optional Commercial Directory API Keys
# (If omitted, the engine automatically uses Public OpenStreetMap Overpass & US State Open Data registries)
GOOGLE_PLACES_API_KEY=
YELP_FUSION_API_KEY=

# Scraper Concurrency & Jitter
DEFAULT_CONCURRENCY=3
DEFAULT_DELAY_MS=350
